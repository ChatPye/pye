# Clerk Authentication (required for production build/deploy)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk paths (Tier 2 — optional; defaults match /sign-in and /sign-up in code)
# Set these in Vercel only if you use custom routes. See docs/DEPLOY.md → "Clerk Tier 2"
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth-callback?redirect=%2Fworkspace
# Client-side copies (only needed if paths differ from defaults):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Local dev without Clerk: set DEV_AUTH_BYPASS=true and use placeholder keys above
DEV_AUTH_BYPASS=false
DEV_HR_ROLE=hr
DEV_ORG_SLUG=dev-org
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Database (DocumentDB/MongoDB — legacy, being migrated)
MONGODB_URI=mongodb://username:password@cluster.docdb.amazonaws.com:27017/chatpye?ssl=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
DB_NAME=chatpye

# Database (Amazon Aurora PostgreSQL — recommended target)
DATABASE_URL=postgresql://user:password@your-aurora-cluster.region.rds.amazonaws.com:5432/chatpye

# MailerLite
MAILERLITE_API_KEY=xxx
MAILERLITE_GROUP_ID=xxx

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
POSTHOG_KEY=phc_xxx
POSTHOG_HOST=https://app.posthog.com

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EXTENSION_ID=your-extension-id

# AWS (for deployment)
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1
AWS_S3_BUCKET=chatpye-uploads

# Rate Limiting (Redis - optional for production)
REDIS_URL=redis://localhost:6379
# Optional: primary analysis for public YouTube tutorials without captions.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.6-flash
COURSE_INVITE_SECRET=replace-with-a-long-random-secret

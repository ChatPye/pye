{
  "name": "chatpye",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 326",
    "lint:security": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit && npm run type-check --workspaces --if-present",
    "test": "jest",
    "test:unit": "jest src/__tests__ --passWithNoTests && npm run test --workspaces --if-present",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests",
    "test:watch": "jest --watch",
    "db:generate": "npm run db:generate --workspace=@chatpye/database",
    "db:push": "npm run db:push --workspace=@chatpye/database",
    "db:migrate": "npm run db:migrate --workspace=@chatpye/database",
    "db:studio": "npm run db:studio --workspace=@chatpye/database",
    "infra:fmt": "terraform -chdir=infra/environments/staging fmt -recursive && terraform -chdir=infra/environments/production fmt -recursive",
    "infra:validate:staging": "terraform -chdir=infra/environments/staging init -backend=false && terraform -chdir=infra/environments/staging validate",
    "infra:validate:production": "terraform -chdir=infra/environments/production init -backend=false && terraform -chdir=infra/environments/production validate"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1075.0",
    "@aws-sdk/client-lambda": "^3.934.0",
    "@aws-sdk/client-rekognition": "^3.893.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.896.0",
    "@aws-sdk/client-textract": "^3.893.0",
    "@aws-sdk/client-transcribe": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@chatpye/ai-core": "*",
    "@chatpye/ai-providers": "*",
    "@chatpye/database": "*",
    "@chatpye/domain": "*",
    "@clerk/nextjs": "^5.0.0",
    "@danielxceron/youtube-transcript": "^1.2.3",
    "@stripe/stripe-js": "^7.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "chart.js": "^4.5.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.2",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.544.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.0.0",
    "next": "^15.5.19",
    "plyr": "^3.8.4",
    "postgres": "^3.4.9",
    "prismjs": "^1.30.0",
    "react": "19",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19",
    "react-router-dom": "^7.9.2",
    "react-syntax-highlighter": "^15.6.6",
    "refractor": "^4.9.0",
    "stripe": "^14.0.0",
    "tesseract.js": "^5.0.0",
    "ytdl-core": "^4.11.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.1",
    "@types/aws-lambda": "^8.10.156",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.19",
    "jest": "^29.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChatPye/chatpye-web.git"
  },
  "author": "ChatPye Team",
  "license": "UNLICENSED"
}
